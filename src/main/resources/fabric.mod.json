{
	"schemaVersion": 1,
	"id": "customname",
	"version": "${version}",
	"name": "Custom Name & Cape",
	"description": "Client-side custom display name and cape selector, extracted as a standalone mod.",
	"authors": ["Custom Name"],
	"license": "MIT",
	"icon": "assets/customname/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.customname.CustomNameClient"]
	},
	"provides": ["customcape"],
	"mixins": [
		"customname.mixins.json",
		"customcape.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version_range}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
